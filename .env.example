# Copy to .env (never committed) and adjust.

# Where the repository is cloned on the server (same path inside the controller)
DEMO_DIR=/opt/vigilo-demo
# Instances: <id>.$DEMO_DOMAIN
DEMO_DOMAIN=vigilo-demo.velocite-montpellier.fr
# Entry point, proxied by the nginx of the host
DEMO_BIND=127.0.0.1:8480

# Install code asked by the setup assistant of every new demo (/admin/, first launch):
# 12 to 64 letters or digits. Generated by install.sh; keep it to create the admin accounts.
VIGILO_SETUP_CODE=

# Branch of the repository followed by the server, check interval (seconds),
# image updates (hours)
DEMO_BRANCH=main
# Fetched over HTTPS by the controller (no SSH key needed, whatever the clone URL)
DEMO_REPO_URL=https://github.com/jesuisundesdeux/vigilo-demo.git
SYNC_INTERVAL=60
PULL_INTERVAL=6

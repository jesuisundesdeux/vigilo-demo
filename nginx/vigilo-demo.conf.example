# nginx of the host: every demo (*.vigilo-demo.velocite-montpellier.fr) goes to the entry
# point of the farm (Traefik, 127.0.0.1:8480). TLS is handled here: a wildcard certificate
# (Let's Encrypt with a DNS challenge, e.g. certbot certonly --dns-<provider>
#  -d '*.vigilo-demo.velocite-montpellier.fr').
# Copy to /etc/nginx/sites-available/vigilo-demo.conf, link it in sites-enabled/,
# adjust the certificate paths, then: nginx -t && systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name *.vigilo-demo.velocite-montpellier.fr;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name *.vigilo-demo.velocite-montpellier.fr;

    ssl_certificate     /etc/letsencrypt/live/vigilo-demo.velocite-montpellier.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vigilo-demo.velocite-montpellier.fr/privkey.pem;

    # Photos sent by the web app (the backend accepts up to 20 MB)
    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:8480;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
    }
}
